# ============================================================
# Vidyamatrix ERP — Environment Variables
# ============================================================
# Copy this file to .env (local dev) or set these in Vercel
# Project Settings → Environment Variables (production).
# NEVER commit your real .env file.
# ============================================================

# --- Database (Neon Postgres) ---
# Pooled connection string (use this for the app — connection pooling via PgBouncer)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require&channel_binding=require"

# Direct connection string (used by Prisma migrations — no pooling)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require"

# --- Auth ---
# Generate a strong random secret: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# --- App ---
# Set to "production" on Vercel (Vercel sets this automatically)
NODE_ENV="development"
