# ============================================================
# Vidyamatrix ERP — Environment Variables
# ============================================================
# Copy this file to .env (local dev) or set these in Vercel
# Project Settings → Environment Variables (production).
# NEVER commit your real .env file.
# ============================================================

# --- Database Provider ---
# "sqlite" for local development (uses a local file)
# "postgresql" for production (Neon)
DATABASE_PROVIDER="sqlite"

# --- Database URL ---
# SQLite (local dev):   file:/path/to/dev.db
# Postgres (production): postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="file:./dev.db"

# --- Postgres only (production) ---
# Direct connection string (used by Prisma migrations — no pooling)
# Required only when DATABASE_PROVIDER="postgresql"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# --- Auth ---
# Generate a strong random secret: openssl rand -base64 32
# In production, this MUST be set (the app throws at runtime if missing)
AUTH_SECRET="dev-only-change-in-production"
